# ---------------------------------------------------------------------------
# Supabase — SOMENTE server-side. A service role key ignora RLS, entao ela
# nunca pode ser exposta com prefixo NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ---------------------------------------------------------------------------
# Firecrawl — scrape + changeTracking das paginas em tracked_pages
# https://firecrawl.dev
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY="fc-..."
# Opcional: instancia self-hosted
FIRECRAWL_API_URL="https://api.firecrawl.dev"

# ---------------------------------------------------------------------------
# Apify — perfil e posts do Instagram
# https://console.apify.com/account/integrations
# ---------------------------------------------------------------------------
APIFY_TOKEN="apify_api_..."
# Actors usados (defaults abaixo); troque se quiser outro actor
APIFY_INSTAGRAM_PROFILE_ACTOR="apify~instagram-profile-scraper"
APIFY_INSTAGRAM_POSTS_ACTOR="apify~instagram-post-scraper"

# ---------------------------------------------------------------------------
# Cron e webhook
# ---------------------------------------------------------------------------
# A Vercel envia `Authorization: Bearer $CRON_SECRET` nas chamadas agendadas.
# Gere com: openssl rand -hex 32
CRON_SECRET="troque-me"

# Segredo do webhook do Firecrawl Monitor. Se ausente, cai no CRON_SECRET.
# Ter um proprio permite rotacionar o webhook sem mexer no cron.
# A doc do Monitor nao descreve assinatura de webhook — a garantia e este
# bearer, gravado no monitor por scripts/create-monitor.ts.
FIRECRAWL_WEBHOOK_SECRET=""

# URL publica da app. Usada pelo cron e pelo webhook para chamar as rotas de
# ingest, e para montar a URL do webhook no monitor.
# Em producao a Vercel injeta VERCEL_PROJECT_PRODUCTION_URL automaticamente.
APP_BASE_URL="http://localhost:3000"

# Destinatario do e-mail semanal do Monitor (npm run monitor:setup)
MONITOR_EMAIL="voce@exemplo.com"
