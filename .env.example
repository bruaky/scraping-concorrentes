# ---------------------------------------------------------------------------
# Supabase — SOMENTE server-side. A service role key ignora RLS, entao ela
# nunca pode ser exposta com prefixo NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ---------------------------------------------------------------------------
# Firecrawl — scrape + changeTracking dos sites dos concorrentes
# https://firecrawl.dev
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY="fc-..."
# Opcional: aponta para uma instancia self-hosted
FIRECRAWL_API_URL="https://api.firecrawl.dev"

# ---------------------------------------------------------------------------
# Apify — detalhes de perfil + posts do Instagram
# https://console.apify.com/account/integrations
# ---------------------------------------------------------------------------
APIFY_TOKEN="apify_api_..."
# Actors usados (defaults abaixo); troque se quiser outro actor
APIFY_INSTAGRAM_PROFILE_ACTOR="apify~instagram-profile-scraper"
APIFY_INSTAGRAM_POSTS_ACTOR="apify~instagram-post-scraper"

# ---------------------------------------------------------------------------
# Cron — a Vercel envia `Authorization: Bearer $CRON_SECRET` nas chamadas
# agendadas. Gere com: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET="troque-me"

# URL base usada pelo cron para chamar as proprias rotas de ingest.
# Em producao a Vercel injeta VERCEL_URL automaticamente.
APP_BASE_URL="http://localhost:3000"
